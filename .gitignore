# ---------- Project-specific large / regenerable artifacts ----------

# Generated/heavy docs artefacts are ignored, but the LaTeX SOURCES are the work
# product and stay tracked.  A parent directory that is itself excluded cannot have
# its contents re-included, so exclude the contents and re-admit the directories.
docs/**
!docs/**/
!docs/**/*.tex
!docs/**/*.bib
!docs/**/*.sty
!docs/**/*.bst
!docs/**/*.cls
!docs/**/*.md
!docs/**/*.txt
!docs/**/*.png
!docs/**/*.pdf
docs/**/*.log
docs/**/*.aux
docs/**/*.out
docs/**/*.bbl
docs/**/*.blg
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.toc
docs/**/*.zip
docs/notebook_pdfs/**
docs/taslp_draft/*.pdf
docs/draft/*.pdf
docs/analysis/*.pdf
docs/publication/*.pdf

# The ICLR paper's tracked snapshot of measured run outputs (scratch is purged;
# this is what make_macros/make_figures fall back to, kept small by
# src/tools/snapshot_results.py)
!docs/iclr2027/results/**

# 41.7 GB HuggingFace release tree + 422 MB sample — never track
hf_release/maestro-eeg-dataset/
hf_release/maestro-eeg-dataset-sample/

# Generated analysis outputs (regenerable from scripts in analysis/scripts/)
analysis/cache/
analysis/results/

# SLURM job logs — clutter, regeneratable
analysis/slurm_logs/

# Any local data symlinks or copies (the real data lives at /fs/ess/PAS2301/)
data/
local_data/
# ...but src/data and configs/data are SOURCE, not data.
!src/data/
!src/data/**
!configs/data/
!configs/data/**

# Notebooks export pdfs are regenerable
docs/notebook_pdfs/

# ---------- Editor / OS / scratch ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.scratch/

# Loader build dir was created during pypi push
hf_release/maestro-loader-pkg/dist/
hf_release/maestro-loader-pkg/build/
hf_release/maestro-loader-pkg/*.egg-info/

# ---------- Secrets / credentials (defense-in-depth) ----------
.env
.env.local
*.pem
*.key
.huggingface/
~/.pypirc

# never commit bytecode or notebook autosaves (placed last so the docs/ re-includes above cannot override them)
__pycache__/
*.pyc
**/.ipynb_checkpoints/

# W&B run files live on scratch (/fs/scratch/PAS2301/alialavi/projects/multimodal_aad__wandb), not in git
wandb/
